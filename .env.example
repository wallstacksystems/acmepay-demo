# AcmePay API - Environment Configuration
# Copy to .env and fill in values. Never commit .env to source control.

# Server
NODE_ENV=development
PORT=3000
API_BASE_URL=https://api.acmepay.io

# Authentication
JWT_SECRET=
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=
API_KEY_SALT=

# Database (Supabase)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-04-10

# Twilio (SMS / voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@acmepay.io
SENDGRID_FROM_NAME=AcmePay

# OpenAI (fraud narrative generation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Encryption
ENCRYPTION_KEY=
ENCRYPTION_IV=

# PII Storage (S3-compatible)
CUSTOMER_PII_BUCKET=acmepay-customer-pii-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Fraud & Risk
FRAUD_SCORE_THRESHOLD=75
VELOCITY_WINDOW_MINUTES=60
MAX_TXN_PER_WINDOW=10
HIGH_RISK_COUNTRIES=NG,KP,IR,CU

# Monitoring
SENTRY_DSN=
LOG_LEVEL=info
